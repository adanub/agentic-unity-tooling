<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SnapshotReader.Tests</AssemblyName>
    <RootNamespace>Adanub.UnityMcp.Snapshot.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Compile-link the engine-free snapshot reader straight from the plugin: it must build with no
       Unity present, so a Unity type creeping into plugin/Editor/Snapshot breaks this build. -->
  <ItemGroup>
    <Compile Include="..\..\plugin\Editor\Snapshot\*.cs" LinkBase="Snapshot" />
  </ItemGroup>

</Project>
